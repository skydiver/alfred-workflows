{
  "name": "alfred-writewise",
  "version": "1.3.0",
  "description": "WriteWise is an Alfred Workflow that automates text review, correcting grammar and spelling errors while suggesting improvements to enhance clarity, coherence, and professionalism in any written communication.",
  "keywords": [
    "alfred",
    "workflow",
    "grammar",
    "spelling",
    "text-review",
    "clarity",
    "slack",
    "jira",
    "confluence",
    "github",
    "text-improvement"
  ],
  "license": "MIT",
  "author": {
    "name": "Mart\u00edn M.",
    "url": "https://github.com/skydiver/"
  },
  "type": "module",
  "main": "build/bundle.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=build/bundle.js",
    "clean": "rimraf build",
    "dev": "tsx watch src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pack": "npm run build && tsx ../../scripts/update-version.ts && tsx ../../scripts/pack.ts && npm run clean"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "rimraf": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
