{
  "name": "alfred-goodlinks",
  "version": "1.0.0",
  "description": "Alfred workflow to manage and organize your GoodLinks bookmarks.",
  "keywords": [
    "alfred",
    "workflow",
    "goodlinks",
    "bookmarks",
    "organization",
    "productivity"
  ],
  "license": "MIT",
  "author": {
    "name": "Martín M.",
    "url": "https://github.com/skydiver/"
  },
  "type": "module",
  "main": "build/bundle.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=build/bundle.js",
    "clean": "rimraf build",
    "dev": "tsx watch src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pack": "npm run build && tsx ../../scripts/update-version.ts && tsx ../../scripts/pack.ts && npm run clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/minimist": "^1.2.5",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "rimraf": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "volta": {
    "node": "22.13.1",
    "pnpm": "10.0.0"
  }
}
